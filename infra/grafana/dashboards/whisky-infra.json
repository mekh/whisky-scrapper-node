    {
      "type": "timeseries",
      "title": "Memory used",
      "description": "The cache has a ceiling and evicts against it; the session store has none and must never evict.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "redis_memory_used_bytes",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{role}} used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "redis_memory_max_bytes > 0",
          "refId": "B",
          "format": "time_series",
          "legendFormat": "{{role}} maxmemory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
