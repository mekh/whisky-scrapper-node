# Every variable this backend reads, plus the few `docker-compose.yaml` reads
# on its own, each with the value it falls back to when the variable is not
# set. Copy to `.env` and change only what a deployment needs.
#
# Three things to know before editing:
#
#  * An empty value is NOT the same as a comment. `docker-compose.yaml`
#    forwards an omitted host variable as an empty string, so the config layer
#    reads empty and blank as "unset" and falls back — which is why every
#    string setting with a default is read through `nonEmpty`.
#  * `docker-compose.yaml` is the gate in production: a variable absent from
#    its `environment` block never reaches the container, whatever this file
#    says. Add new ones to both.
#  * A few are deliberately **pinned** there and cannot be set from `.env` at
#    all. The addresses of sibling containers (`DB_HOST`, `DB_PORT`,
#    `VALKEY_HOST`, `VALKEY_PORT`, `VALKEY_DB`, `CACHE_VALKEY_HOST`,
#    `CACHE_VALKEY_PORT`) and `APP_HOST` are facts of the compose project;
#    `SWAGGER_ENABLED` is required by the web client's build; and the
#    deployment's settled logging answers (`LOG_JSON`, `LOG_PRETTY`,
#    `LOG_COLOR`, `LOG_CALLSITES`, `DB_LOGGING`, `DB_SLOW_QUERY_MS`) are
#    fixed there too; `LOG_LEVEL` is forwarded, with `info` when unset. The values below are still the
#    application's own defaults, which is what a run outside the container
#    uses.


# =============================================================================
# Deployment (read by docker-compose.yaml, not by the application)
# =============================================================================

# OPTIONAL — host address the API is published on; 127.0.0.1 would keep it off
# the network entirely. Published by the `lb` service, not by the app itself:
# the app replicas are reachable only inside the compose network.
APP_BIND_IP=192.168.179.2

# OPTIONAL — host port the API is published on; nginx proxies /api to it.
APP_BIND_PORT=9977

# OPTIONAL — host address Postgres is published on; scripts/db-backup.sh reaches it over TCP, so it cannot be unpublished.
PG_BIND_IP=192.168.179.2

# OPTIONAL — host port Postgres is published on; scripts/db-backup.env must name the same one.
PG_BIND_PORT=5431

# OPTIONAL — Postgres shared buffers. Six times the whole database at the
# default, deliberately below the conventional 25% of RAM: see the comment on
# the `db` service in docker-compose.yaml and docs/POSTGRES-TUNING.md.
PG_SHARED_BUFFERS=1GB

# OPTIONAL — what the planner assumes the OS has cached. A hint, not an allocation.
PG_EFFECTIVE_CACHE_SIZE=8GB

# OPTIONAL — Postgres work_mem. Applies per sort/hash NODE, so it multiplies by
# the number of busy connections; raise it knowing DB_POOL_SIZE is 50.
PG_WORK_MEM=16MB

# OPTIONAL — Postgres maintenance_work_mem; VACUUM, index builds and migrations only.
PG_MAINTENANCE_WORK_MEM=512MB

# OPTIONAL — host address the session store is published on.
VALKEY_BIND_IP=192.168.179.2

# OPTIONAL — host port the session store is published on.
VALKEY_BIND_PORT=6378

# OPTIONAL — host address the catalogue cache is published on; the app reaches it by container name, so this is only for valkey-cli.
CACHE_BIND_IP=192.168.179.2

# OPTIONAL — host port the catalogue cache is published on.
CACHE_BIND_PORT=6377

# OPTIONAL — how much the catalogue cache may hold before it evicts its oldest entries.
# Production runs 3072mb: the 2026-09-13 ladder peaked at 1.16 GiB and the
# previous 976 MiB cap was evicting live entries (4 038 of them), each of
# which is a database query later. NB the unit suffixes differ between the
# two settings — Valkey reads `mb` as 1024^2 and a bare `m` as 1000^2.
CACHE_MAXMEMORY=512mb

# OPTIONAL — the cache container's memory limit; keep it above CACHE_MAXMEMORY or the container is OOM-killed instead of evicting.
CACHE_MEMORY_LIMIT=640M

# OPTIONAL — existing Docker volume holding the Postgres cluster; it is declared external, so a wrong name fails the deploy instead of creating an empty database.
PG_VOLUME=whisky_whisky_pg_data

# OPTIONAL — existing Docker volume holding the session store's data, declared external for the same reason.
VALKEY_VOLUME=whisky_whisky_valkey_data


# =============================================================================
# Application
# =============================================================================

# OPTIONAL — name the application reports about itself.
APP_NAME=Whisky Scrapper

# OPTIONAL — interface the HTTP server binds to.
APP_HOST=0.0.0.0

# OPTIONAL — port the server listens on inside the container. The load
# balancer's backend names it too (haproxy.cfg), so changing it means
# changing that file as well.
APP_PORT=4000

# OPTIONAL — whether request logging is installed at all.
APP_LOGGING=true

# OPTIONAL — level the application's own logger starts at.
APP_LOGLEVEL=info

# OPTIONAL — mount Swagger UI and /docs-json, which are unauthenticated routes.
SWAGGER_ENABLED=false

# OPTIONAL — comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=https://whisky.vlm.com.ua

# OPTIONAL — budget for one request inside the app, in ms; 0 disables it.
APP_REQUEST_TIMEOUT_MS=30000

# OPTIONAL — deadline in ms for a request that stalls in a guard, before any interceptor runs.
APP_REQUEST_DEADLINE_MS=45000

# OPTIONAL — keep-alive timeout in ms; keep it above the proxy's own.
APP_KEEP_ALIVE_TIMEOUT_MS=72000

# OPTIONAL — headers the client's address may be read from, most trusted first.
APP_TRUSTED_IP_HEADERS=x-real-ip,x-forwarded-for

# OPTIONAL — whether any forwarding header is trusted at all; set false when no proxy fronts this process.
APP_TRUST_PROXY=true


# =============================================================================
# Database
# =============================================================================

# REQUIRED — database name; the app refuses to start without it.
DB_NAME=

# REQUIRED — database user.
DB_USER=

# REQUIRED — database password.
DB_PASS=

# OPTIONAL — database host; the dev compose publishes Postgres on localhost.
DB_HOST=localhost

# OPTIONAL — database port; left unset the driver uses 5432, and the dev compose publishes 5431.
DB_PORT=5432

# OPTIONAL — echo every statement to the log.
DB_LOGGING=false

# OPTIONAL — include bound parameters in a logged statement, which are user data in production.
DB_LOG_PARAMETERS=false

# OPTIONAL — a statement slower than this many ms is logged as slow.
DB_SLOW_QUERY_MS=100

# OPTIONAL — connections in the pool across ALL instances, divided by
# APP_INSTANCES at startup. Set against the database's max_connections
# (100), not against the instance count: this value stays put however
# many instances run. The superseded DB_POOL_SIZE now fails the boot.
#
# 50 is the code's fallback; production runs 24, and that is a measurement
# rather than caution. Cutting it from 50 raised the database's throughput
# (~340 -> ~360 commits/s) because 48 backends is six times the host's core
# count, and those cores are shared with three Node replicas, two Valkeys
# and HAProxy. Raising it is the wrong direction — docs/LOAD-TEST-2026-09.md.
DB_POOL_SIZE_TOTAL=50

# OPTIONAL — how many instances of the API to run. This one number is both
# the compose replica count and the divisor of the pool above, so the two
# cannot drift apart. The `lb` service balances across them; nothing outside
# docker-compose.yaml changes when it changes, and the host nginx keeps
# proxying to the same address. Past 16 the slot count in
# haproxy.cfg has to be raised too.
APP_INSTANCES=1

# OPTIONAL — connection attempts at startup before giving up; left unset TypeORM uses 10.
DB_RETRY_ATTEMPTS=10

# OPTIONAL — pause between those attempts, in ms; left unset TypeORM uses 3000.
DB_RETRY_DELAY=3000

# OPTIONAL — how long a caller may queue for a pooled connection, in ms.
DB_ACQUIRE_TIMEOUT_MS=5000

# OPTIONAL — server-side statement timeout, in ms.
DB_STATEMENT_TIMEOUT_MS=60000

# OPTIONAL — server-side idle-in-transaction timeout, in ms.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=120000


# =============================================================================
# Authentication
# =============================================================================

# REQUIRED — secret the access tokens are signed with.
JWT_ACCESS_SECRET=

# OPTIONAL — access-token lifetime, in seconds.
JWT_ACCESS_EXPIRES=600

# OPTIONAL — refresh-token lifetime, in seconds.
REFRESH_EXPIRES_SEC=604800


# =============================================================================
# Session store (Valkey)
# =============================================================================
#
# Holds auth sessions and the login throttle. Never give this instance an
# eviction policy: a missing session key is read as a revoked session and
# signs that user out of every device.

# OPTIONAL — host of the session instance; the dev compose publishes it on localhost.
VALKEY_HOST=127.0.0.1

# OPTIONAL — port of the session instance; the dev compose publishes 6378.
VALKEY_PORT=6379

# OPTIONAL — logical database index; unset uses the server's own default.
VALKEY_DB=

# OPTIONAL — password; unset means the server takes none.
VALKEY_PASSWORD=

# OPTIONAL — prefix the client prepends to every key it writes.
VALKEY_PREFIX=

# OPTIONAL — how long one command may wait for its reply, in ms.
VALKEY_COMMAND_TIMEOUT_MS=2000

# OPTIONAL — how long a connection attempt may take, in ms.
VALKEY_CONNECT_TIMEOUT_MS=5000

# OPTIONAL — TCP keep-alive delay, in ms.
VALKEY_KEEP_ALIVE_MS=10000

# OPTIONAL — retries per command before it is rejected.
VALKEY_MAX_RETRIES_PER_REQUEST=2

# OPTIONAL — queue commands while disconnected instead of failing them fast.
VALKEY_OFFLINE_QUEUE=false


# =============================================================================
# Catalogue cache
# =============================================================================
#
# Serves GET /report/:kind and GET /meta from Valkey. Every connection setting
# falls back to its VALKEY_* equivalent, so leaving them all unset shares the
# session instance; production points them at the dedicated `whisky-cache`
# container instead. See docs/VALKEY-CACHE-PROD.md.

# OPTIONAL — the kill switch; false restores the behaviour predating the cache.
CACHE_ENABLED=true

# OPTIONAL — bump the generation once at startup, which the scripts turn off for themselves.
CACHE_BOOT_BUMP=true

# OPTIONAL — entry lifetime in seconds; garbage collection, not freshness.
CACHE_TTL_SEC=86400

# OPTIONAL — deadline for one cache command, in ms; a slower cache is a miss.
CACHE_READ_TIMEOUT_MS=250

# OPTIONAL — largest entry stored, in bytes, measured after compression.
CACHE_MAX_ENTRY_BYTES=8388608

# OPTIONAL — largest page-addressable report set stored, in bytes: its
# compressed index plus every group as written (uncompressed). The full
# catalogue is ~6 MB; a filter producing more is served and not cached.
CACHE_MAX_SET_BYTES=33554432

# OPTIONAL — cache host; falls back to VALKEY_HOST, and production sets whisky-cache.
CACHE_VALKEY_HOST=127.0.0.1

# OPTIONAL — cache port; falls back to VALKEY_PORT, dev compose publishes 6377.
CACHE_VALKEY_PORT=6379

# OPTIONAL — cache database index; falls back to VALKEY_DB.
CACHE_VALKEY_DB=

# OPTIONAL — cache password; falls back to VALKEY_PASSWORD.
CACHE_VALKEY_PASSWORD=

# OPTIONAL — cache key prefix; falls back to VALKEY_PREFIX.
CACHE_VALKEY_PREFIX=

# OPTIONAL — cache command timeout in ms; falls back to the session client's.
CACHE_VALKEY_COMMAND_TIMEOUT_MS=2000

# OPTIONAL — cache connect timeout in ms; falls back to the session client's.
CACHE_VALKEY_CONNECT_TIMEOUT_MS=5000

# OPTIONAL — cache TCP keep-alive in ms; falls back to the session client's.
CACHE_VALKEY_KEEP_ALIVE_MS=10000

# OPTIONAL — cache retries per command; falls back to the session client's.
CACHE_VALKEY_MAX_RETRIES_PER_REQUEST=2


# =============================================================================
# Rate limiting
# =============================================================================

# OPTIONAL — whether per-caller rate limiting is enforced.
RATE_LIMIT_ENABLED=true

# OPTIONAL — sustained requests per second per caller, across the whole API.
RATE_LIMIT_RPS=3

# OPTIONAL — how many of those a caller may spend at once.
RATE_LIMIT_BURST=10

# OPTIONAL — sustained rate for /report and /dashboard.
RATE_LIMIT_HEAVY_RPS=1

# OPTIONAL — burst allowance for /report and /dashboard.
RATE_LIMIT_HEAVY_BURST=60

# OPTIONAL — sustained rate for /collection.
RATE_LIMIT_STRICT_RPS=1

# OPTIONAL — burst allowance for /collection.
RATE_LIMIT_STRICT_BURST=3

# OPTIONAL — sustained rate for the two public auth routes.
RATE_LIMIT_AUTH_RPS=1

# OPTIONAL — burst allowance for the two public auth routes.
RATE_LIMIT_AUTH_BURST=5

# OPTIONAL — how long one charge may take before the request is let through
# uncounted. The buckets live in the session Valkey and are charged by one
# script call before every handler, so this bounds the hot path; it fails
# open, and the limiter is never worth more than the handler it guards.
RATE_LIMIT_TIMEOUT_MS=250

# RATE_LIMIT_MAX_KEYS and RATE_LIMIT_SWEEP_MS are gone (2026-09-13): the
# buckets moved into Valkey and expire when they would next hold their full
# burst, which bounds them more tightly than the old in-process cap did.


# =============================================================================
# Logging
# =============================================================================
#
# Read by @toxicoder/nestjs-pino, not by this repository's config classes.

# OPTIONAL — pino's level. Production forwards it with `info` as the default;
# `trace` makes the request interceptor log every response body.
LOG_LEVEL=info

# OPTIONAL — emit JSON lines rather than human-readable ones.
LOG_JSON=true

# OPTIONAL — pretty-print, for a terminal.
LOG_PRETTY=false

# OPTIONAL — colourise the pretty output. NB the name is singular.
LOG_COLOR=false

# OPTIONAL — include the call site of each line.
LOG_CALLSITES=false

# OPTIONAL — let the ORM's own logger through pino.
LOG_DB=false


# =============================================================================
# Scraping and the LLM passes
# =============================================================================

# OPTIONAL — multiplies every adapter's politeness delay; below 1 is faster.
SCRAPE_DELAY_MULTIPLIER=1

# OPTIONAL — key for the OpenAI-compatible endpoint; unset disables all three LLM passes.
LLM_API_KEY=

# OPTIONAL — the endpoint itself; any OpenAI-compatible gateway works.
LLM_BASE_URL=https://openrouter.ai/api/v1

# OPTIONAL — model slug for the LLM passes; unset disables all three, as an unset key does.
LLM_MODEL=

# OPTIONAL — whether the model is asked to reason, which on a batch can eat the whole answer budget.
LLM_REASONING=false

# OPTIONAL — model for the flavour pass alone; unset reuses LLM_MODEL.
LLM_FLAVOR_MODEL=

# OPTIONAL — reasoning for the flavour pass alone; unset reuses LLM_REASONING.
LLM_FLAVOR_REASONING=

# OPTIONAL — model for the brand research script; unset reuses LLM_MODEL.
LLM_RESEARCH_MODEL=

# OPTIONAL — batches in flight per pass; politeness, not a provider limit.
LLM_CONCURRENCY=5

# OPTIONAL — per-request timeout for the SDK, in ms.
LLM_TIMEOUT_MS=120000

# OPTIONAL — retries the SDK makes per request.
LLM_MAX_RETRIES=2

# OPTIONAL — sent as OpenRouter's X-Title, which names this app in its log.
LLM_APP_NAME=Whisky dev

# OPTIONAL — sent as OpenRouter's HTTP-Referer.
LLM_APP_URL=https://whisky.vlm.com.ua/


# =============================================================================
# Knowledge base
# =============================================================================

# OPTIONAL — re-apply the knowledge base to the catalogue once at startup, so a deploy needs no manual reconcile.
KB_APPLY_ON_BOOT=true


# =============================================================================
# Store synchronisation
# =============================================================================

# OPTIONAL — arm the daily full-sync schedule, which ships off because a scrape starting on its own is a surprise.
SYNC_CRON_ENABLED=false

# OPTIONAL — when that schedule fires; an unusable expression fails the boot.
SYNC_CRON_EXPRESSION=0 12 * * *

# OPTIONAL — timezone the expression is read in.
SYNC_TIMEZONE=Europe/Kyiv

# OPTIONAL — store tracks collected concurrently during a full sync.
SYNC_MAX_PARALLEL_TRACKS=4

# OPTIONAL — budget for one HTTP store's run, in ms.
SYNC_STORE_TIMEOUT_MS=1200000

# OPTIONAL — budget for one browser-tier store's run, in ms.
SYNC_BROWSER_STORE_TIMEOUT_MS=2700000

# OPTIONAL — how early the optional passes stop so the run can still persist, in ms.
SYNC_LLM_DEADLINE_MARGIN_MS=120000

# OPTIONAL — directory for the per-run log files; empty disables them.
SYNC_LOG_DIR=./log

# OPTIONAL — how long those files are kept, in days; 0 keeps them forever.
SYNC_LOG_RETENTION_DAYS=30


# =============================================================================
# Push notifications
# =============================================================================

# OPTIONAL — whether price-drop digests are sent after a sync.
PUSH_ENABLED=false

# OPTIONAL — VAPID public key; rotating it invalidates every subscription.
PUSH_VAPID_PUBLIC_KEY=

# OPTIONAL — VAPID private key; a missing pair degrades to "push off".
PUSH_VAPID_PRIVATE_KEY=

# OPTIONAL — VAPID subject; the library rejects an empty one.
PUSH_VAPID_SUBJECT=mailto:admin@localhost

# OPTIONAL — pushes sent in parallel during one dispatch.
PUSH_CONCURRENCY=8

# OPTIONAL — how long the push service should hold an undelivered message, in seconds.
PUSH_TTL_SEC=86400

# OPTIONAL — how long the dedup log is kept, in days.
PUSH_LOG_RETENTION_DAYS=30


# =============================================================================
# Currency rates
# =============================================================================

# OPTIONAL — base URL of the National Bank's open-data endpoint.
NBU_BASE_URL=https://bank.gov.ua

# OPTIONAL — timeout for one rate request, in ms.
NBU_TIMEOUT_MS=30000

# OPTIONAL — retries for one rate request.
NBU_RETRIES=3

# OPTIONAL — currencies to track; the base currency is never among them.
CURRENCY_RATE_CODES=USD,EUR

# OPTIONAL — arm the daily rate schedule, on by default because stale rates show wrong money everywhere.
CURRENCY_RATE_CRON_ENABLED=true

# OPTIONAL — when it fires; the bank publishes after 15:30 Kyiv.
CURRENCY_RATE_CRON_EXPRESSION=30 16 * * *

# OPTIONAL — timezone that expression is read in.
CURRENCY_RATE_TIMEZONE=Europe/Kyiv

# OPTIONAL — trailing window each run re-fetches, in days; every write is an idempotent upsert.
CURRENCY_RATE_SYNC_WINDOW_DAYS=7
