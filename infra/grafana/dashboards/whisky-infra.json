    {
      "type": "timeseries",
      "title": "Transactions / s",
      "description": "~360 commits/s was the measured ceiling with a 24-connection pool; raising the pool lowered it.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_commit[5m]))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "commits"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))",
          "refId": "B",
          "format": "time_series",
          "legendFormat": "rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "description": "This database is ~150 MB and fully resident; a load test read 99.997% of its blocks from cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Oldest open transaction",
      "description": "A long one holds back vacuum across the whole database.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "whisky_activity_oldest_transaction_seconds",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
