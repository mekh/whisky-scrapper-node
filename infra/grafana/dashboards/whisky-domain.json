    {
      "type": "timeseries",
      "title": "Cache operations / s",
      "description": "`bypass` is the cache being skipped on purpose — disabled, a payload over the size cap, or a bump outstanding.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "sum by (result) (rate(whisky_cache_operations_total[5m]))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Cache command latency p95",
      "description": "Bounded by CACHE_READ_TIMEOUT_MS (250 ms); anything at the ceiling is a timeout, which reads as a miss.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(whisky_cache_command_duration_seconds_bucket[10m])))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
