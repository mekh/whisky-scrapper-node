      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "sum(pg_stat_activity_count)",
          "refId": "A",
          "format": "time_series",
