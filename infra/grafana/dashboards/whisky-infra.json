          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Memory per container",
      "description": "Against its limit. A container killed rather than shedding load is one whose limit sits below what it was told to use.",
      "datasource": {
        "type": "prometheus",
        "uid": "whisky-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "whisky-prometheus"
          },
          "expr": "container_memory_working_set_bytes{name=~\"whisky-.*\"}",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{name}}"
        }
