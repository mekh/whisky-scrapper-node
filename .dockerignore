# Deployment config the image never runs: the HAProxy and nginx configs are
# mounted from the host, and the monitoring stack is a separate compose
# project. Excluded so editing any of it does not invalidate the build cache
# — which `COPY . .` in the build stage would otherwise do on every Grafana
# dashboard edit.
