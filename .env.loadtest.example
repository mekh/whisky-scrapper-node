# Environment for `pnpm loadtest:seed` when it targets another deployment
# than the one `.env` describes. Copy to `.env.loadtest` (git-ignored — it
# holds that deployment's secrets), fill the blanks, and run the seed with
#
#   DOTENV_CONFIG_PATH=.env.loadtest pnpm loadtest:seed --users 1000 --prefs
#
# dotenv reads only the file this variable names, so nothing from `.env`
# leaks in. Three values are load-bearing beyond the database itself:
#
# - JWT_ACCESS_SECRET must be the API's own, or every minted token is
#   rejected with 401.
# - VALKEY_HOST/PORT must be the SESSION instance (`whisky-valkey`), not the
#   cache, and VALKEY_PREFIX must match the API's, or the sessions the seed
#   writes are invisible to `AuthJwtGuard` and every request answers 401.
# - The host's published ports are not the compose defaults: read them off
#   `docker ps` on the host.

DB_HOST=192.168.180.1
DB_PORT=10432
DB_NAME=
DB_USER=
DB_PASS=

VALKEY_HOST=192.168.180.1
VALKEY_PORT=10379
VALKEY_DB=0
VALKEY_PASSWORD=
VALKEY_PREFIX=

JWT_ACCESS_SECRET=
