.idea/
# macOS Finder metadata, at any depth.
.DS_Store
/dist
/node_modules
/build
/openapi.json
# Per-sync log files, written at runtime and bind-mounted into the container.
/log
/.env
# Backup config holds the DB password; only the .example is committed.
/scripts/db-backup.env
/.env.development.local
/.env.test.local
/.env.production.local
/.env.local
*.dump
# Load test: the seeded users' tokens and the k6 run outputs, plus the env
# file that points the seed at another environment (holds its secrets).
/loadtest/users.json
/loadtest/out
/.env.loadtest

# The Alertmanager bot token, written by the operator. The stack starts
# without it — the Telegram receiver ships commented out — so a missing file
# is the normal state, not a broken one.
infra/alertmanager/telegram-token

# A deployment's own Alertmanager config. `receivers:` cannot be split out of
# that file — Alertmanager has no include directive — so a deployment that
# routes anywhere copies the tracked one and edits the copy. The copy is
# ignored here so that editing it never makes `git pull` a merge.
infra/alertmanager/*.local.yml

# The monitoring project's own environment, which carries the Grafana admin
# password and the database credentials its exporter uses.
infra/.env
